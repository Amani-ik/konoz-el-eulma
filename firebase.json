{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "FIRESTORE_SECURITY_RULES",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
